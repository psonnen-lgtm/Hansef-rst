      "sha256": "d3484547ff5eb62b55de7a0cf7380e3ad6e1f3a7fc7a5614822db5391b45bc1a",
      "sourceExcerpt": "function promote(){if(s.rank>=2)return runMayorElection();const i=s.rank+1;if(netWorth()<[0,18000,45000][i]||s.rep<[0,0,25][i])return false;return politicalAction(null,()=>{s.rank=i;politicalNote(s.name+' steigt auf: '+rank()+'!');Testlog.event('promotion',{rank:i});return true})}"
